# MENTOR Frontend Environment Variables (Public client-side configuration)
# NOTE: Variables starting with VITE_ are embedded into the client build.
# NEVER place secret credentials, private tokens, or database keys in this file.

# ==============================================================================
# Public Gateway / Domain Configuration
# SINGLE SOURCE OF TRUTH:
# Change this single variable when pointing frontend to VPS or cloud staging/prod:
# e.g. VITE_GATEWAY_URL=https://api.yourdomain.com (or http://<VPS_IP>:8000)
# ==============================================================================
VITE_GATEWAY_URL=http://localhost:8000

# API Base URL (Relative path '/api' is recommended for zero-domain reverse proxy routing)
VITE_API_BASE_URL=/api

# Default HTTP Request Timeout in milliseconds (e.g. 15000 = 15s)
VITE_API_TIMEOUT=15000

# Application Environment ('development', 'testing', 'production')
VITE_APP_ENV=development

# Keycloak OpenID Connect Configuration
# (Defaults to ${VITE_GATEWAY_URL}/auth if omitted or empty)
VITE_KEYCLOAK_URL=http://localhost:8000/auth
VITE_KEYCLOAK_REALM=mentor
VITE_KEYCLOAK_CLIENT_ID=mentor-frontend
