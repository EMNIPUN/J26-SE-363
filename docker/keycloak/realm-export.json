{
  "realm": "mentor",
  "enabled": true,
  "displayName": "SELVIA",
  "sslRequired": "external",
  "loginTheme": "mentor",
  "emailTheme": "mentor",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(10) and notUsername and notEmail",
  "roles": {
    "realm": [
      {
        "name": "student",
        "description": "Kept for compatibility. A person's student or lecturer role is chosen in the app and stored in the Core API database."
      },
      {
        "name": "lecturer",
        "description": "Kept for compatibility. See the student role."
      },
      {
        "name": "admin",
        "description": "Platform administrator. The Core API trusts this role from the token."
      }
    ]
  },
  "clients": [
    {
      "clientId": "mentor-frontend",
      "name": "SELVIA Web Application",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*",
        "https://mentor-frontend-testing.vercel.app/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://mentor-frontend-testing.vercel.app"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##https://mentor-frontend-testing.vercel.app/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    }
  ]
}
