# ==============================================================================
# AI Backend and agent worker settings. Copy to backend/agentic_framework/.env
# (gitignored) and run the AI Backend and the worker from backend/agentic_framework/.
# The Core API has its own file: backend/server/.env.example
# Never put Core API secrets here (Supabase service role key, Keycloak client secret).
# ==============================================================================

# AI Backend settings use the AI_BACKEND_ prefix
AI_BACKEND_APP_ENV=development
# Shared secret the Core API must send in the X-Internal-Token header. Same value as
# AI_BACKEND_INTERNAL_TOKEN in backend/server/.env. Without it every orchestration call is refused.
AI_BACKEND_INTERNAL_TOKEN=[GENERATE_A_LONG_RANDOM_STRING]

# ==============================================================================
# Job queue database (used by the worker only)
# ==============================================================================
# The same PostgreSQL database as the Core API, and the AI Backend's only database setting.
# The worker reads SERVER_DIRECT_URL, else SERVER_DATABASE_URL, from this file (it is loaded
# from the current folder, so start the worker from backend/agentic_framework/). A blank value
# counts as unset; with neither set the worker refuses to start.
# Use the session pooler (port 5432) or a direct connection, not the transaction pooler (6543).
# The worker never changes the schema: install and secure the queue from backend/server/
# (docs/SERVER_DATABASE_GUIDE.md, section 3F).
#
# A Supabase URL must end with ?sslmode=verify-full&sslrootcert=../certs/supabase-ca.crt;
# the worker refuses sslmode=require, verify-ca, no sslmode or no sslrootcert. The path points
# to the committed Supabase CA certificate (backend/certs/supabase-ca.crt), relative to the
# current folder, which is why the worker must start from backend/agentic_framework/.
SERVER_DIRECT_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=../certs/supabase-ca.crt

# Local Docker PostgreSQL (selvia_server_postgres on host port 5433) instead of Supabase:
# SERVER_DIRECT_URL=postgresql+psycopg://selvia_server_user:your_local_password@localhost:5433/selvia_server_db

# ==============================================================================
# Agent settings
# ==============================================================================
# Add each agent's variables below with its own prefix (e.g. PLANNING_, TUTOR_, SECURITY_ASSISTANT_).
# The performance assessment agent keeps its own .env inside its folder.

# Security Assistant detection tools (app/agents/security_assistant/tools). Raw tool output is written here, never inside
# the scanned repository. Per-tool time limits in seconds (default 300, CodeQL 900):
# SECURITY_ASSISTANT_SCAN_DIR=/var/lib/selvia/security_assistant_scans
# SECURITY_ASSISTANT_TOOL_TIMEOUT=300
# SECURITY_ASSISTANT_TOOL_TIMEOUT_CODEQL=900
# Tools run one after another by default; raise this to run several at once (needs more RAM).
# SECURITY_ASSISTANT_MAX_PARALLEL=1

# GitHub webhook entry path (app/agents/security_assistant/webhook.py). Must equal the secret
# configured on the GitHub webhook. Without it every delivery is rejected.
# SECURITY_ASSISTANT_WEBHOOK_SECRET=change-me

# Security Assistant LLM Semantic Interpreter (app/agents/security_assistant/interpreter). Groq, used by this
# component only (own client in interpreter/llm.py; to change provider implement LLMClient there). Both are required;
# there is deliberately no default model, models get retired: pick one from https://console.groq.com/docs/models.
# Models that support strict structured outputs get the verdict schema, others JSON Object Mode.
# SECURITY_ASSISTANT_LLM_API_KEY=gsk_your-groq-key
# SECURITY_ASSISTANT_LLM_MODEL=your-groq-model-id
# SECURITY_ASSISTANT_LLM_TIMEOUT=60
# SECURITY_ASSISTANT_LLM_MAX_TOKENS=4096

# Personal data redaction before LLM calls (app/agents/security_assistant/pii.py). Defaults: student id IT + 8 digits.
# SECURITY_ASSISTANT_STUDENT_ID_REGEX=\bIT\d{8}\b
# Names to redact wherever they appear (comma separated), in addition to names found on labelled lines
# SECURITY_ASSISTANT_PII_KNOWN_NAMES=First Last, Other Name
# Fixes the contributor pseudonyms of the trace command between runs (otherwise a random salt is kept in trace_mapping.local.json)
# SECURITY_ASSISTANT_PSEUDONYM_SALT=

# Agent loops: budgets (a decision counts as one step; the final stop counts too). The shared names apply to every loop.
# SECURITY_ASSISTANT_AGENT_MAX_STEPS=
# SECURITY_ASSISTANT_AGENT_MAX_RETRIES=
# SECURITY_ASSISTANT_ORCHESTRATOR_MAX_STEPS=20
# SECURITY_ASSISTANT_ORCHESTRATOR_MAX_RETRIES=1
# SECURITY_ASSISTANT_QUESTION_MAX_STEPS=200
# SECURITY_ASSISTANT_QUESTION_MAX_RETRIES=2
