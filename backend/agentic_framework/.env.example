# ==============================================================================
# AI Backend and agent worker settings. Copy to backend/agentic_framework/.env
# (gitignored) and run the AI Backend and the worker from backend/agentic_framework/.
# The Core API has its own file: backend/server/.env.example
# Never put Core API secrets here (Supabase service role key, Keycloak client secret).
# ==============================================================================

# AI Backend settings use the AI_BACKEND_ prefix
AI_BACKEND_APP_ENV=development

# ==============================================================================
# Job queue database (used by the worker only)
# ==============================================================================
# The same PostgreSQL database as the Core API, and the AI Backend's only database setting.
# The worker reads SERVER_DIRECT_URL, else SERVER_DATABASE_URL, from this file (it is loaded
# from the current folder, so start the worker from backend/agentic_framework/). A blank value
# counts as unset; with neither set the worker refuses to start.
# Use the session pooler (port 5432) or a direct connection, not the transaction pooler (6543).
# The worker never changes the schema: install and secure the queue from backend/server/
# (docs/SERVER_DATABASE_GUIDE.md, section 3F).
#
# A Supabase URL must end with ?sslmode=verify-full&sslrootcert=../certs/supabase-ca.crt;
# the worker refuses sslmode=require, verify-ca, no sslmode or no sslrootcert. The path points
# to the committed Supabase CA certificate (backend/certs/supabase-ca.crt), relative to the
# current folder, which is why the worker must start from backend/agentic_framework/.
SERVER_DIRECT_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=../certs/supabase-ca.crt

# Local Docker PostgreSQL (selvia_server_postgres on host port 5433) instead of Supabase:
# SERVER_DIRECT_URL=postgresql+psycopg://selvia_server_user:your_local_password@localhost:5433/selvia_server_db

# ==============================================================================
# Agent settings
# ==============================================================================
# Add each agent's variables below with its own prefix (e.g. PLANNING_, TUTOR_, AEGIS_).
# The performance assessment agent keeps its own .env inside its folder.
