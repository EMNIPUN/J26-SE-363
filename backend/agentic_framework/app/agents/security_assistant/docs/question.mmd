---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	ask(ask)
	score(score)
	follow_up(follow_up)
	close(close)
	escalate(escalate)
	__end__([<p>__end__</p>]):::last
	__start__ --> ask;
	ask -.-> escalate;
	ask -.-> score;
	follow_up --> score;
	score -.-> close;
	score -.-> escalate;
	score -.-> follow_up;
	close --> __end__;
	escalate --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
