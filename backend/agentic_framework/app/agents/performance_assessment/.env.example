# ==============================================================================
# PERFORMANCE ASSESSMENT AGENT - ENVIRONMENT TEMPLATE (.env.example)
# Decoupled agent environment configuration template
# ==============================================================================

# Environment mode: 'development' or 'production'
COM_AGENT_ENV=development

# Docker Compose Profiles:
# Set to 'prod' to include the assessment_agent container in Docker.
# Leave empty to run only PostgreSQL in Docker for local development.
COMPOSE_PROFILES=

# PostgreSQL Database Configuration
POSTGRES_DB=assessment_db
POSTGRES_USER=assessment_user
POSTGRES_PASSWORD=assessment_pass
POSTGRES_HOST=assessment_postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434

# Standalone Agent Port
AGENT_PORT=8002

# Observability & Tracing (LangSmith)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=performance_assessment_com_agent
