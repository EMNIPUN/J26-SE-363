---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	fetch(fetch)
	scan(scan)
	governance(governance)
	interpret(interpret)
	trace(trace)
	risk(risk)
	guidance(guidance)
	questions(questions)
	report(report)
	__end__([<p>__end__</p>]):::last
	__start__ --> fetch;
	fetch -.-> report;
	fetch -.-> scan;
	governance --> interpret;
	guidance --> questions;
	interpret --> trace;
	questions --> report;
	risk --> guidance;
	scan -.-> governance;
	scan -.-> report;
	trace --> risk;
	report --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
%% scan nests the orchestrator graph (orchestrator.mmd), questions nests the question graph (question.mmd), and every LLM call
%% (interpret, trace) passes the governance gate (governance.mmd). Stage statuses live in the graph state.
