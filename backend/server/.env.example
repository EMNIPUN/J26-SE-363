# ==============================================================================
# Core API (backend/server) settings. Copy to backend/server/.env (gitignored) and
# run the Core API, Alembic and the scripts from backend/server/.
# The AI Backend and the worker have their own file: backend/agentic_framework/.env.example
# Every name below is a field of app/core/config.py (Settings). Real environment
# variables override values in this file. Never commit the filled-in .env.
# ==============================================================================

APP_NAME=SELVIA Server
APP_ENV=development
# DEBUG=false

# ==============================================================================
# Database (REQUIRED: configure one option locally)
# ==============================================================================
# The two URLs have different jobs:
#   SERVER_DATABASE_URL  the Core API's own connection for API requests. On Supabase: the
#                        transaction pooler (port 6543).
#   SERVER_DIRECT_URL    schema changes (Alembic, the queue install and hardening scripts) and
#                        the job queue. On Supabase: the session pooler (port 5432), or a direct
#                        connection if your project supports it. Never the transaction pooler.
#
# Which variable each part of the Core API uses, in order of precedence:
#   - API requests (SQLAlchemy):     SERVER_DATABASE_URL, else a URL built from the
#                                    SERVER_POSTGRES_* parts below.
#   - Alembic migrations,            -x db_url / --db-url, then SERVER_DIRECT_URL, then
#     scripts/install_queue_schema,  SERVER_DATABASE_URL (which may be built from the parts).
#     scripts/secure_queue_schema:
#   - Job queue (publishing jobs):   SERVER_DIRECT_URL, then SERVER_DATABASE_URL, as written
#                                    in this file; the SERVER_POSTGRES_* parts are not used.
# A blank value (SERVER_DIRECT_URL=) counts as unset. If nothing is configured the Core API
# raises an error; it never falls back to a default database.
#
# Remote schema changes: Alembic and the two queue scripts refuse non-local hosts (such as
# Supabase) unless explicitly allowed, and even then refuse a remote URL that came from
# SERVER_DATABASE_URL (because SERVER_DIRECT_URL is unset) or uses port 6543. So set
# SERVER_DIRECT_URL explicitly before any remote schema change.
#
# TLS: every Supabase URL (both of them) must end with
#   ?sslmode=verify-full&sslrootcert=../certs/supabase-ca.crt
# The Core API, Alembic and the scripts refuse a Supabase URL with sslmode=require, verify-ca,
# no sslmode or no sslrootcert. The Supabase CA certificate is public and committed at
# backend/certs/supabase-ca.crt. The relative path is resolved from the current folder, so run
# the Core API, Alembic and the scripts from backend/server/.
# Details: docs/SERVER_DATABASE_GUIDE.md, sections 2 and 3.

# --- Option A: Supabase ---
# Transaction pooler (port 6543) for API requests:
SERVER_DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=../certs/supabase-ca.crt
# Session pooler (port 5432) for schema changes and the job queue:
SERVER_DIRECT_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=../certs/supabase-ca.crt
# URL-encode special characters in the password (for example @ becomes %40).

# --- Option B: local Docker PostgreSQL (selvia_server_postgres on host port 5433) ---
# SERVER_DATABASE_URL=postgresql+psycopg://selvia_server_user:[YOUR_LOCAL_PASSWORD]@localhost:5433/selvia_server_db
# SERVER_DIRECT_URL=postgresql+psycopg://selvia_server_user:[YOUR_LOCAL_PASSWORD]@localhost:5433/selvia_server_db

# --- Option C: parts, used only when SERVER_DATABASE_URL is unset or blank ---
# USER, PASSWORD and DB are all required; HOST defaults to localhost and PORT to 5433.
# SERVER_POSTGRES_USER=selvia_server_user
# SERVER_POSTGRES_PASSWORD=[YOUR_LOCAL_PASSWORD]
# SERVER_POSTGRES_HOST=localhost
# SERVER_POSTGRES_PORT=5433
# SERVER_POSTGRES_DB=selvia_server_db

# SERVER_TEST_DATABASE_URL is not a Core API setting: only the migration, job-API and queue
# install tests read it, and only from your shell (docs/SERVER_DATABASE_GUIDE.md, section 5),
# never from this file. It must be a local PostgreSQL database whose name ends in _test and
# that isn't the database above; the tests never fall back to the URLs above.

# ==============================================================================
# Keycloak (defaults match the local Docker Compose stack)
# ==============================================================================
# Tokens must be issued by {KEYCLOAK_SERVER_URL}/realms/{KEYCLOAK_REALM}.
KEYCLOAK_SERVER_URL=http://localhost:8000/auth
KEYCLOAK_REALM=mentor
# Only when the Core API must fetch signing keys from a different (internal) URL:
# KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/mentor/protocol/openid-connect/certs
# Clients whose access tokens are accepted (token claim azp), as a JSON list:
KEYCLOAK_ALLOWED_CLIENTS=["mentor-frontend"]
# Supported but not used by any code yet:
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=

# ==============================================================================
# Browser access and the AI Backend
# ==============================================================================
# Browser origins allowed to call the Core API, as a JSON list:
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

AI_BACKEND_URL=http://localhost:8003
AI_BACKEND_TIMEOUT_SECONDS=60

# ==============================================================================
# Optional: supported but not used by any code yet. Leave unset unless a feature needs them.
# ==============================================================================
# Once the security migration is applied, the Core API tables are closed to the roles behind
# these keys (anon, authenticated, service_role); see docs/SERVER_DATABASE_GUIDE.md, section 3F.
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_KEY=[YOUR_SUPABASE_ANON_KEY]
# SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]
# SUPABASE_BUCKET_RUBRICS=project-rubrics
# GITHUB_TOKEN=[YOUR_GITHUB_TOKEN]
# AGENT_JOB_RETENTION_HOURS=24
