# Performance Assessment Component Agent (com_agent) Environment Configuration
# Strictly aligned with PLAN.md Section 7.2 & 12.8

# Execution environment ('development' uses in-process mocks; 'production' uses live adapters)
COM_AGENT_ENV=development

# Observability and LangChain Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=performance_assessment_com_agent
