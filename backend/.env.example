APP_NAME=SELVIA Server
APP_ENV=development
DEBUG=true

# ==============================================================================
# Server Database Configuration
# ==============================================================================

# --- Option A: Supabase Cloud PostgreSQL (Default) ---
# Runtime Transaction Pooler (Port 6543 - for FastAPI queries):
SERVER_DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Direct / Session Connection (Port 5432 - for Alembic migrations):
SERVER_DIRECT_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# --- Option B: Optional Local Dockerized PostgreSQL ---
# If using the local Docker container (selvia_server_postgres on host port 5433) instead of Supabase:
# SERVER_DATABASE_URL=postgresql+psycopg://selvia_server_user:your_local_password@localhost:5433/selvia_server_db
# SERVER_DIRECT_URL=postgresql+psycopg://selvia_server_user:your_local_password@localhost:5433/selvia_server_db


# ==============================================================================
# Supabase Project Credentials & Storage (Required if using Supabase)
# ==============================================================================
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==============================================================================
# Agent Job Queue Retention (Clean up finished/failed jobs older than X hours)
# ==============================================================================
AGENT_JOB_RETENTION_HOURS=24

# ==============================================================================
# Authentication (Keycloak) and browser access
# ==============================================================================
# Public Keycloak URL behind Kong; must match the `iss` of the frontend's tokens.
KEYCLOAK_SERVER_URL=http://localhost:8000/auth
KEYCLOAK_REALM=mentor
# Only when the server must fetch the signing keys from an internal URL (e.g. inside Docker):
# KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/mentor/protocol/openid-connect/certs
# Clients whose tokens are accepted (JSON list)
KEYCLOAK_ALLOWED_CLIENTS=["mentor-frontend"]
# Browser origins allowed to call the Core API (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ==============================================================================
# Core API -> AI Backend (Main Orchestrator)
# ==============================================================================
AI_BACKEND_URL=http://localhost:8003
AI_BACKEND_TIMEOUT_SECONDS=60

# AI Backend's own settings use the AI_BACKEND_ prefix (optional overrides)
# AI_BACKEND_APP_ENV=development