APP_NAME=SELVIA
APP_ENV=development
DEBUG=true
# ==============================================================================
# Server Database Configuration (Option A: Supabase Cloud / Option B: Local Docker)
# ==============================================================================
# Option A: Supabase Cloud PostgreSQL (Transaction Pooler - recommended for FastAPI):
# SERVER_DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# SERVER_DIRECT_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Option B: Dedicated Local Docker PostgreSQL (Port 5433):
SERVER_DATABASE_URL=postgresql+psycopg://${SERVER_POSTGRES_USER}:${SERVER_POSTGRES_PASSWORD}@localhost:5433/${SERVER_POSTGRES_DB}

# Optional Supabase storage credentials (for rubric PDF/DOCX storage)
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Keycloak IAM Integration
KEYCLOAK_SERVER_URL=http://localhost:8000/auth
KEYCLOAK_REALM=selvia
KEYCLOAK_CLIENT_ID=selvia-server
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here

# GitHub Evidence Ingestion
GITHUB_TOKEN=your_github_personal_access_token_here

# Agentic Framework Database (internal agent memory / assessment db)
DATABASE_URL=postgresql+psycopg://selvia:password@localhost:5432/selvia

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password

OPENAI_API_KEY=your_key_here