APP_NAME=SELVIA
APP_ENV=development
DEBUG=true
# Server PostgreSQL Database (dedicated web server database on port 5433)
SERVER_DATABASE_URL=postgresql+psycopg://selvia_server_user:your_secure_server_postgres_password_here@localhost:5433/selvia_server_db

# Agentic Framework Database (internal agent memory / assessment db)
DATABASE_URL=postgresql+psycopg://selvia:password@localhost:5432/selvia

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password

OPENAI_API_KEY=your_key_here