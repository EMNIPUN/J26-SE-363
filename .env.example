# ==============================================================================
# Docker Compose Profiles
# Leave blank on local developer machines to prevent downloading Keycloak/Kong images.
# Set to 'infra' on your VPS or when running full stack locally: COMPOSE_PROFILES=infra
# ==============================================================================
COMPOSE_PROFILES=

# ==============================================================================
# Database Configuration (PostgreSQL for Keycloak IAM)
# ==============================================================================
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ==============================================================================
# Public Gateway / Domain Configuration
# SINGLE SOURCE OF TRUTH FOR ALL SERVICES:
# For local development: http://localhost:8000
# For VPS / Cloud deployment: https://api.yourdomain.com (or http://<VPS_IP>:8000)
# ==============================================================================
GATEWAY_PUBLIC_URL=http://localhost:8000
VITE_GATEWAY_URL=http://localhost:8000

# ==============================================================================
# Keycloak IAM Configuration
# (Automatically inherits from GATEWAY_PUBLIC_URL if left as below)
# ==============================================================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password_here
KEYCLOAK_HOSTNAME_URL=http://localhost:8000/auth
KEYCLOAK_HOSTNAME_ADMIN_URL=http://localhost:8000/auth
KEYCLOAK_HOSTNAME_STRICT=false
KEYCLOAK_HOSTNAME_STRICT_BACKCHANNEL=false
KEYCLOAK_HTTP_RELATIVE_PATH=/auth

# ==============================================================================
# Kong API Gateway Configuration
# ==============================================================================
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# ==============================================================================
# Sign-in email and social login (applied by docker/keycloak/configure_realm.py)
# See docker/keycloak/README.md for the steps and for creating the OAuth apps.
# ==============================================================================
# Addresses of the web app, comma separated. Keycloak only redirects people back to these.
FRONTEND_URLS=http://localhost:5173

# Mail server for verification and password-reset emails. Without it, nobody can finish
# registering. For development use Mailpit: docker compose --profile dev up -d mailpit
#   KC_SMTP_HOST=host.docker.internal  KC_SMTP_PORT=1025  KC_SMTP_SECURITY=none
KC_SMTP_HOST=
KC_SMTP_PORT=587
KC_SMTP_SECURITY=starttls
KC_SMTP_USER=
KC_SMTP_PASSWORD=
KC_SMTP_FROM=no-reply@yourdomain.example
KC_SMTP_FROM_NAME=SELVIA

# Social sign-in: set both values of a pair to switch a provider on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
